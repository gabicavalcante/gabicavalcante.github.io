# Hugo build output — deployed by GitHub Actions, never committed.
/public/
/resources/_gen/
.hugo_build.lock

# Hugo module cache
/_vendor/
# Agent tooling and local-only files (the CV PDF that /cv/ is written from).
.agents/
.local/
# Everything under .claude/ is local except the skills, which are versioned with
# the blog they operate on. Listing the directory contents rather than .claude/
# itself is deliberate: git does not descend into an ignored directory, so a
# negation inside one never matches.
.claude/*
!.claude/skills/
.claude/settings*.json
